import com.availelabs.availe.domain.model.CurrencyCode;
import com.availelabs.availe.domain.model.Email;
import com.availelabs.availe.domain.model.ImageUrl;
import com.availelabs.availe.domain.model.ListingCategory;
import com.availelabs.availe.domain.model.ListingCreationTime;
import com.availelabs.availe.domain.model.ListingDescription;
import com.availelabs.availe.domain.model.ListingId;
import com.availelabs.availe.domain.model.ListingTitle;
import com.availelabs.availe.domain.model.PriceAmount;
import com.availelabs.availe.domain.model.UserId;
import com.availelabs.availe.domain.model.TimeZoneIdentifier;
import kotlin.Boolean;
import kotlin.collections.List;
import kotlin.time.Instant;
import kotlinx.datetime.LocalDateTime;

CREATE TABLE listings (
    primary_key_id TEXT AS ListingId NOT NULL PRIMARY KEY,
    created_at TEXT AS ListingCreationTime NOT NULL,
    publisher_id TEXT AS UserId NOT NULL,
    publisher_email TEXT AS Email NOT NULL,
    listing_type TEXT AS ListingCategory NOT NULL,
    title TEXT AS ListingTitle NOT NULL,
    description TEXT AS ListingDescription,
    price_amount TEXT AS PriceAmount NOT NULL,
    price_currency TEXT AS CurrencyCode NOT NULL,
    image_links TEXT AS List<ImageUrl> NOT NULL,
    is_rsvped INTEGER AS Boolean NOT NULL DEFAULT 0,
    is_favorited INTEGER AS Boolean NOT NULL DEFAULT 0
);

CREATE TABLE listing_item_details (
    listing_id TEXT AS ListingId NOT NULL PRIMARY KEY,
    FOREIGN KEY(listing_id) REFERENCES listings(primary_key_id) ON DELETE CASCADE
);

CREATE TABLE listing_event_details (
    listing_id TEXT AS ListingId NOT NULL PRIMARY KEY,
    start_local_time TEXT AS LocalDateTime NOT NULL,
    end_local_time TEXT AS LocalDateTime NOT NULL,
    start_instant INTEGER AS Instant NOT NULL,
    end_instant INTEGER AS Instant NOT NULL,
    time_zone_identifier TEXT AS TimeZoneIdentifier NOT NULL,
    FOREIGN KEY(listing_id) REFERENCES listings(primary_key_id) ON DELETE CASCADE
);

CREATE TABLE listing_service_details (
    listing_id TEXT AS ListingId NOT NULL PRIMARY KEY,
    FOREIGN KEY(listing_id) REFERENCES listings(primary_key_id) ON DELETE CASCADE
);

upsertListing:
INSERT OR REPLACE INTO listings(primary_key_id, created_at, publisher_id, publisher_email, listing_type, title, description, price_amount, price_currency, image_links, is_rsvped, is_favorited)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

upsertItemDetails:
INSERT OR REPLACE INTO listing_item_details(listing_id)
VALUES (?);

upsertEventDetails:
INSERT OR REPLACE INTO listing_event_details(listing_id, start_local_time, end_local_time, start_instant, end_instant, time_zone_identifier)
VALUES (?, ?, ?, ?, ?, ?);

upsertServiceDetails:
INSERT OR REPLACE INTO listing_service_details(listing_id)
VALUES (?);

observeListings:
SELECT *
FROM listings
LEFT JOIN listing_item_details ON listings.primary_key_id = listing_item_details.listing_id
LEFT JOIN listing_event_details ON listings.primary_key_id = listing_event_details.listing_id
LEFT JOIN listing_service_details ON listings.primary_key_id = listing_service_details.listing_id
WHERE (:publisher_id IS NULL OR listings.publisher_id = :publisher_id)
AND (listings.listing_type IN :categories)
ORDER BY listings.created_at DESC
LIMIT :limit;

observeUpcomingEvents:
SELECT *
FROM listings
LEFT JOIN listing_item_details ON listings.primary_key_id = listing_item_details.listing_id
LEFT JOIN listing_event_details ON listings.primary_key_id = listing_event_details.listing_id
LEFT JOIN listing_service_details ON listings.primary_key_id = listing_service_details.listing_id
WHERE (:publisher_id IS NULL OR listings.publisher_id = :publisher_id)
AND listings.listing_type = 'Event'
AND listing_event_details.end_instant >= :current_instant
ORDER BY listing_event_details.start_instant ASC
LIMIT :limit;

observePastEvents:
SELECT *
FROM listings
LEFT JOIN listing_item_details ON listings.primary_key_id = listing_item_details.listing_id
LEFT JOIN listing_event_details ON listings.primary_key_id = listing_event_details.listing_id
LEFT JOIN listing_service_details ON listings.primary_key_id = listing_service_details.listing_id
WHERE (:publisher_id IS NULL OR listings.publisher_id = :publisher_id)
AND listings.listing_type = 'Event'
AND listing_event_details.end_instant < :current_instant
ORDER BY listing_event_details.end_instant DESC
LIMIT :limit;

observeGoingEvents:
SELECT *
FROM listings
LEFT JOIN listing_item_details ON listings.primary_key_id = listing_item_details.listing_id
LEFT JOIN listing_event_details ON listings.primary_key_id = listing_event_details.listing_id
LEFT JOIN listing_service_details ON listings.primary_key_id = listing_service_details.listing_id
WHERE (:publisher_id IS NULL OR listings.publisher_id = :publisher_id)
AND listings.listing_type = 'Event'
AND listings.is_rsvped = 1
ORDER BY listing_event_details.start_instant ASC
LIMIT :limit;

selectById:
SELECT *
FROM listings
LEFT JOIN listing_item_details ON listings.primary_key_id = listing_item_details.listing_id
LEFT JOIN listing_event_details ON listings.primary_key_id = listing_event_details.listing_id
LEFT JOIN listing_service_details ON listings.primary_key_id = listing_service_details.listing_id
WHERE listings.primary_key_id = ?;

deleteById:
DELETE FROM listings
WHERE primary_key_id = ?;

deleteListings:
DELETE FROM listings
WHERE (:publisher_id IS NULL OR listings.publisher_id = :publisher_id)
AND (listings.listing_type IN :categories);

deleteUpcomingEvents:
DELETE FROM listings
WHERE (:publisher_id IS NULL OR listings.publisher_id = :publisher_id)
AND listings.listing_type = 'Event'
AND primary_key_id IN (
    SELECT listing_id FROM listing_event_details WHERE end_instant >= :current_instant
);

deletePastEvents:
DELETE FROM listings
WHERE (:publisher_id IS NULL OR listings.publisher_id = :publisher_id)
AND listings.listing_type = 'Event'
AND primary_key_id IN (
    SELECT listing_id FROM listing_event_details WHERE end_instant < :current_instant
);

deleteGoingEvents:
DELETE FROM listings
WHERE (:publisher_id IS NULL OR listings.publisher_id = :publisher_id)
AND listings.listing_type = 'Event'
AND is_rsvped = 1;

countListings:
SELECT count(*) FROM listings;